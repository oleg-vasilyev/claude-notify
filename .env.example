# claude-notify — copy this to .env and fill in the token.
# .env is gitignored; nothing here ever leaves the machine.
# `npm run setup` writes this file for you and keeps any comments you add.

# From @BotFather: /newbot, then paste the token it gives you.
BOT_TOKEN=

# Your chat with the bot. Leave empty and setup resolves it after you have
# written /start to the bot at least once.
CHAT_ID=

# How this machine is named in a ping: [job-finder@home]
MACHINE_LABEL=home

# Minutes without keyboard or mouse that count as "away". Below this the ping
# is queued instead of sent, because the sound is already enough.
MIN_IDLE_MINUTES=3

# How long a queued ping stays worth delivering. Past this you were clearly at
# the machine the whole time and have already seen it.
STALE_MINUTES=15

# Append the 5-hour and weekly limit windows to each ping.
INCLUDE_USAGE=true

# Whether the text of a question may leave this machine. Set to false on a
# machine whose work should stay on it: the ping then says only that an answer
# is wanted, and questions with options are never asked on the phone, since
# asking one means sending it. A permission still names its tool and nothing
# more. Independent of every other machine — this is a per-machine file.
QUOTE_QUESTIONS=true

# Minutes to wait for an answer from Telegram when Claude asks a question or
# wants a permission while you are away. The question arrives with buttons; you
# can also just reply in your own words. Past this the question is handed back
# to the app as if the bot had never been there. 0 turns answering off.
ASK_MINUTES=10
